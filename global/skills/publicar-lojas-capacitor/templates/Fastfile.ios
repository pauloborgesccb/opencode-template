default_platform(:ios)

platform :ios do
  desc 'Build assinado e envio para o TestFlight'
  lane :beta do
    setup_ci
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_P8'],
      is_key_content_base64: false
    )
    # Certificados já populados no repo do match; readonly em CI evita criação acidental.
    # Se precisar renovar certificados, rode uma vez com readonly: false.
    match(type: 'appstore', readonly: is_ci)

    # Projeto Capacitor 8 usa SPM (sem CocoaPods): build pelo .xcodeproj.
    # Assinatura manual com o certificado/profile que o match instalou.
    profile_name = 'match AppStore {{BUNDLE_ID}}'
    team_id = ENV['sigh_{{BUNDLE_ID}}_appstore_team-id'] || '{{TEAM_ID}}'
    update_code_signing_settings(
      path: 'App.xcodeproj',
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile_name,
      bundle_identifier: '{{BUNDLE_ID}}',
      targets: ['App']
    )
    build_app(
      project: 'App.xcodeproj',
      scheme: 'App',
      export_method: 'app-store',
      export_options: {
        teamID: team_id,
        provisioningProfiles: { '{{BUNDLE_ID}}' => profile_name }
      }
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
